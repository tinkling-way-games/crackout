{
  "name": "crackout",
  "version": "0.1.0",
  "private": true,
  "description": "Crackout — ガラスのブロック崩し (TypeScript + Canvas 2D)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node scripts/serve.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:e2e": "node e2e/smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
